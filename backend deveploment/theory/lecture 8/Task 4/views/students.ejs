<!DOCTYPE html>
<html>
<head>
  <title>Student List</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1>Student List</h1>

  <table>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Branch</th>
    </tr>

    <% students.forEach((student) => { %>
      <tr>
        <td><%= student.id %></td>
        <td><%= student.name %></td>
        <td><%= student.branch %></td>
      </tr>
    <% }) %>
  </table>
</body>
</html>