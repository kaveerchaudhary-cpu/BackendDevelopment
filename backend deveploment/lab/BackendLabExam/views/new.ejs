<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Note</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container">
        <h1>Add New Note</h1>

        <form action="/notes" method="POST" class="note-form">

            <label for="title">Title</label>
            <input
                type="text"
                id="title"
                name="title"
                required
            >

            <label for="content">Content</label>
            <textarea
                id="content"
                name="content"
                rows="6"
                required
            ></textarea>

            <label for="category">Category</label>
            <input
                type="text"
                id="category"
                name="category"
                placeholder="General"
            >

            <button type="submit">Add Note</button>

        </form>

        <a href="/" class="back-button">Back to Notes</a>
    </div>

</body>
</html>